#line 30 "/Project/LandmassComputeShader.usf"
[numthreads(1, 1, 1)] 
void MarchingCube(uint3 ThreadId : SV_DispatchThreadID, uint3 GroupId : SV_GroupID)
{   
    int x = ThreadId.x;
    int y = ThreadId.y;
    int z = ThreadId.z;

    int GlobalIndex = (x + (y * 2) + (z * 4));




    uint Index;








    int3 cornerPos[8];

    cornerPos[0] = ThreadId + int3(0, 0, 0);
    cornerPos[1] = ThreadId + int3(1, 0, 0);
    cornerPos[2] = ThreadId + int3(1, 0, 1);
    cornerPos[3] = ThreadId + int3(0, 0, 1);
    cornerPos[4] = ThreadId + int3(0, 1, 0);
    cornerPos[5] = ThreadId + int3(1, 1, 0);
    cornerPos[6] = ThreadId + int3(1, 1, 1);
    cornerPos[7] = ThreadId + int3(0, 1, 1);

    int CubeIndex = 0;
    for (int i = 0; i < 8; i++)
    {
        if (DensityMap[cornerPos[i]] > 0)
        {
            CubeIndex |= (1U << i);
        }
    }


    if (CubeIndex == 0 || CubeIndex == 255)
    {

        Triangle DummyTri;

        DummyTri.vertex1 = float3(-1,-1,-1);
        DummyTri.vertex2 = float3(-1,-1,-1);
        DummyTri.vertex3 = float3(-1,-1,-1);

        Triangles[Index] = DummyTri;

        return;
    }










    for (int j = 0; j < 16; j += 3)
    {
        if (edgeIndices[j] == -1)
        {
            break;
        }


        int edge1 = TriangleTable[CubeIndex][j];

        float3 edgeVertex1 = EdgeTable[edge1][0];
        float3 edgeVertex2 = EdgeTable[edge1][1];

        int edge2 = TriangleTable[CubeIndex][j + 1];
        float3 edgeVertex3 = EdgeTable[edge2][0];
        float3 edgeVertex4 = EdgeTable[edge2][1];

        int edge3 = TriangleTable[CubeIndex][j + 2];
        float3 edgeVertex5 = EdgeTable[edge3][0];
        float3 edgeVertex6 = EdgeTable[edge3][1];



        float3 Vert1 = ThreadId + edgeVertex1;
        float3 Vert2 = ThreadId + edgeVertex2;

        float3 Vert3 = ThreadId + edgeVertex3;
        float3 Vert4 = ThreadId + edgeVertex4;

        float3 Vert5 = ThreadId + edgeVertex5;
        float3 Vert6 = ThreadId + edgeVertex6;

        Triangle Tri;

        Tri.vertex1 = (Vert1 + Vert2) / 2;
        Tri.vertex2 = (Vert3 + Vert4) / 2;
        Tri.vertex3 = (Vert5 + Vert6) / 2;

        InterlockedAdd(Counter[0], 1, Index);
        Triangles[Index] = Tri;

    }
}

