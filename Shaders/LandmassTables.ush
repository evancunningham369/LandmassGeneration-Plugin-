#ifndef LANDMASSTABLES
#define LANDMASSTABLES

static const int GetScalarIndex(int3 LocalPosition)
{
    // Compare components individually
    if (LocalPosition.x == 0 && LocalPosition.y == 0 && LocalPosition.z == 0)
        return 0;
    if (LocalPosition.x == 1 && LocalPosition.y == 0 && LocalPosition.z == 0)
        return 1;
    if (LocalPosition.x == 1 && LocalPosition.y == 0 && LocalPosition.z == 1)
        return 2;
    if (LocalPosition.x == 0 && LocalPosition.y == 0 && LocalPosition.z == 1)
        return 3;
    if (LocalPosition.x == 0 && LocalPosition.y == 1 && LocalPosition.z == 0)
        return 4;
    if (LocalPosition.x == 1 && LocalPosition.y == 1 && LocalPosition.z == 0)
        return 5;
    if (LocalPosition.x == 1 && LocalPosition.y == 1 && LocalPosition.z == 1)
        return 6;
    if (LocalPosition.x == 0 && LocalPosition.y == 1 && LocalPosition.z == 1)
        return 7;

    return -1; // Invalid position
}

